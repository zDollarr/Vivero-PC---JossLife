{
  "name": "vivero-pc-pruebas",
  "productName": "JossLife - Manager Pruebas",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de gestión de inventario para Vivero",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "build": "npm run build:web && electron-builder",
    "build:pruebas": "npm run build:web && electron-builder --win"
  },
  "dependencies": {
    "firebase": "^11.3.1",
    "html2pdf.js": "^0.12.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^29.1.0",
    "electron-builder": "^24.12.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.viverojosslife.manager.pruebas",
    "productName": "JossLife Manager Pruebas",
    "directories": {
      "output": "release-pruebas",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "JL Manager Pruebas ${version}.${ext}",
      "icon": "build/Icono.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "uninstallDisplayName": "JossLife Manager Pruebas"
    },
    "publish": null
  }
}